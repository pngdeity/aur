/// PKGBUILD(5) Typed Data Model (Pkl)
/// Covers the complete PKGBUILD(5) surface area plus repository-specific
/// _-prefixed variables defined in docs/PKGBUILD-CUSTOM-VARIABLES-REFERENCE.md
///
/// Usage:
///   pkl eval packages/<name>/package.pkl --format json  →  JSON for OPA
///   pkl eval packages/<name>/package.pkl                →  PKGBUILD text
///
/// References:
///   - PKGBUILD(5):       https://man.archlinux.org/man/PKGBUILD.5
///   - Pkl Language Ref:  https://pkl-lang.org/main/current/language-reference/index.html
module schemas.arch_pkg

import "custom_types.pkl" as ct
import "licenses.spdx.pkl" as spdx

// ── Type Aliases ──

/// Known architecture values (PKGBUILD(5) §7.7)
typealias KnownArchitecture = "x86_64" | "i686" | "aarch64" | "armv7h" | "arm" | "any"

/// License identifier. Either "custom" (optionally with ":" qualifier), "LicenseRef-*" (SPDX custom), or an SPDX identifier.
typealias LicenseId =
  "custom"
    | String(matches(Regex(#"^custom:[A-Za-z0-9.+_-]+$"#)))
    | String(matches(Regex(#"^LicenseRef-[A-Za-z0-9.-]+$"#)))
    | spdx.SpdxId

/// Dependency entry: package name with optional single version constraint (>=, <=, =, >, <) and optional epoch.
/// Multiple constraints require separate array entries (PKGBUILD(5) convention).
typealias DependsEntry =
  String(
    matches(Regex(#"^[a-z0-9@._+][a-z0-9@._+-]*(?:(?:[<>]=|[<>=])(?:\d+:)?[a-zA-Z0-9._]+)?$"#)),
  )

/// Provision entry: package name with optional =version (no comparison operators per PKGBUILD(5)).
typealias ProvidesEntry =
  String(matches(Regex(#"^[a-z0-9@._+][a-z0-9@._+-]*(?:=(?:\d+:)?[a-zA-Z0-9._]+)?$"#)))

/// Checksum entry: hex digest or "SKIP" (VCS sources).
typealias ChecksumEntry = "SKIP" | String(matches(Regex(#"^[A-Fa-f0-9]+$"#)))

/// Known makepkg option flags (PKGBUILD(5) §7.19)
typealias KnownOption =
  "!strip"
    | "!debug"
    | "!lto"
    | "!staticlibs"
    | "!emptydirs"
    | "!zipman"
    | "!docs"
    | "!libtool"
    | "!ccache"
    | "!distcc"
    | "!buildflags"
    | "!makeflags"
    | "strip"
    | "debug"
    | "lto"
    | "staticlibs"
    | "emptydirs"
    | "zipman"
    | "docs"
    | "libtool"
    | "ccache"
    | "distcc"
    | "buildflags"
    | "makeflags"

// ── Sub-Classes ──

/// A single source entry, optionally renamed via filename::url syntax.
/// Example: "opendoas::git+https://github.com/Duncaen/OpenDoas.git#tag=v6.8.2"
class SourceEntry {
  /// Full URL including VCS fragments (#tag=, #commit=, #branch=)
  url: String(this.length > 0)

  /// Local filename this source will be saved as
  filename: String(this.length > 0 && !this.startsWith("/"))
}

/// A single optional dependency with its description.
/// PKGBUILD entry: 'wl-clipboard: clipboard support on Wayland'
class OptDependsEntry {
  /// Package name (before the ": "). Same format as depends.
  name: DependsEntry

  /// Description (after the ": ")
  desc: String = ""
}

// ── Package Class ──

/// Top-level PKGBUILD class. Closed by default — no undeclared properties are permitted.
class Package {
  // Identity (PKGBUILD(5) convention: # Maintainer:/# Contributor: comments)

  /// Primary maintainer. Must match "Name <email>" format (PKGBUILD(5) convention).
  maintainer: String(matches(Regex(#"^[^<>]+ <[^<>]+@[^<>]+>$"#))) =
    "pngdeity <pngdeity@tutanota.com>"

  /// Past contributors. Free-form — may be bare name, "Name <email>", or "Name <url>" (PKGBUILD(5) convention, loosely enforced).
  contributor: Listing<String(this.length > 0)>?

  // Identity & Versioning (PKGBUILD(5) §7.1-7.5, 7.16)

  /// Package name. Must start with alphanumeric, @, ., _, or + (not hyphen).
  pkgname: String(matches(Regex(#"^[a-z0-9@._+][a-z0-9@._+-]*$"#)))

  /// Split package group name. Defaults to first element of pkgname if omitted (PKGBUILD(5)).
  pkgbase: String(matches(Regex(#"^[a-z0-9@._+][a-z0-9@._+-]*$"#)))?

  /// Software version number. Must not contain colons, forward slashes, hyphens, or whitespace (PKGBUILD(5)).
  pkgver: String(matches(Regex(#"^[^-/: \t]+$"#)))

  /// Packaging revision index. Positive number, floats allowed for variant builds.
  pkgrel: Number(this > 0)

  /// Epoch (only set when version numbering changes). Must be positive (> 0); default is 0 when omitted.
  epoch: Int(this > 0)?

  /// Package description. Must be 1-80 characters.
  pkgdesc: String(this.length > 0 && this.length <= 80)

  /// Changelog filename. Must be a basename (no path separators) ending in .changelog.
  changelog: String(!this.contains("/") && this.length > 0 && this.endsWith(".changelog"))?

  // Architecture & Metadata (PKGBUILD(5) §7.7, 7.8, 7.12, 7.13)

  /// Target architectures. If "any" is present, it must be the sole entry.
  arch: Listing<KnownArchitecture>(!this.contains("any") || this.length == 1)

  /// Upstream URL. Must start with https://.
  url: String(this.startsWith("https://"))

  /// Software licenses
  license: Listing<LicenseId>

  /// Package groups (rarely used)
  groups: Listing<String(matches(Regex(#"^[a-z0-9@._+][a-z0-9@._+-]*$"#)))>?

  // Package Relationships (PKGBUILD(5) §7.14, 7.15)

  /// Runtime dependencies
  depends: Listing<DependsEntry>?

  /// Build-time dependencies. Same format as depends.
  makedepends: Listing<DependsEntry>?

  /// Test-only dependencies. Same format as depends.
  checkdepends: Listing<DependsEntry>?

  /// Optional dependencies with descriptions
  optdepends: Listing<OptDependsEntry>?

  /// Virtual packages provided. Must be bare name or name=version only (no comparison operators).
  provides: Listing<ProvidesEntry>?

  /// Conflicting packages. Same format as depends.
  conflicts: Listing<DependsEntry>?

  /// Replaced packages. Same format as depends.
  replaces: Listing<DependsEntry>?

  // Source & Integrity (PKGBUILD(5) §7.9, 7.10, 7.17)

  /// Download sources
  source: Listing<SourceEntry>?

  /// Architecture-specific sources (PKGBUILD(5) source_<arch>)
  source_x86_64: Listing<SourceEntry>?
  source_aarch64: Listing<SourceEntry>?

  sha256sums: Listing<ChecksumEntry>?
  sha512sums: Listing<ChecksumEntry>?
  sha224sums: Listing<ChecksumEntry>?
  sha384sums: Listing<ChecksumEntry>?
  b2sums: Listing<ChecksumEntry>?

  /// Architecture-specific checksums (PKGBUILD(5) sha512sums_<arch>)
  sha512sums_x86_64: Listing<ChecksumEntry>?
  sha512sums_aarch64: Listing<ChecksumEntry>?

  /// Valid PGP key fingerprints. Uppercase hex only, no whitespace (PKGBUILD(5)).
  validpgpkeys: Listing<String(matches(Regex(#"^[A-F0-9]+$"#)))>?

  /// Source files to not extract
  noextract: Listing<String(this.length > 0 && !this.startsWith("/"))>?

  // Install & Config (PKGBUILD(5) §7.11, 7.18, 7.19)

  /// .install scriptlet filename. Must be a basename ending in .install.
  install: String(!this.contains("/") && this.length > 0 && this.endsWith(".install"))?

  /// Configuration files to preserve on upgrade. Relative paths (no leading /).
  backup: Listing<String(this.length > 0 && !this.startsWith("/"))>?

  /// makepkg option flags
  options: Listing<KnownOption>?

  // Lifecycle Functions (PKGBUILD(5) §8.8-8.9)
  // Stored as raw Bash text. Named "packageFunc" because "package" is a Pkl keyword.

  /// verify() — source authentication. Runs before extraction (PKGBUILD(5)).
  verify: String(!this.isEmpty)?

  /// pkgver() dynamic version function (VCS packages)
  pkgverFunc: String(!this.isEmpty)?

  /// prepare() — source preparation
  prepare: String(!this.isEmpty)?

  /// build() — compilation
  build: String(!this.isEmpty)?

  /// check() — test suite
  check: String(!this.isEmpty)?

  /// package() — packaging. Named "packageFunc" because "package" is a Pkl keyword.
  packageFunc: String(!this.isEmpty)?

  // Custom Variables (Repository-Specific)
  // Accessible within the class. Some are un-hidden for the sync shell to read
  // via `pkl eval --format json`. They drive build system behavior and are
  // emitted in rendered PKGBUILD output but stripped by aur-deploy.py.

  /// AUR deployment gate. Mutually exclusive with _repo_subarch.
  _deploy_aur: Boolean = false

  /// Canonical software name (without variant suffix). Discriminator for variant groups.
  _pkgname: String?

  /// GitHub owner/repo for changelog generation
  _githubname: ct.GitHubName?

  /// AUR package name for upstream merge
  _upstream_aur_pkg: String?

  /// Arch GitLab repo path for upstream merge
  _upstream_arch_repo: String?

  /// Convert upstream maintainer to contributor
  _demote_upstream_maintainer: Boolean = false

  /// Auto-adopt upstream build logic changes
  _auto_merge_build: Boolean = false

  /// Synchronize shared gemini settings asset
  _use_common_gemini_settings: Boolean = false

  /// Sub-architecture target (variant builds only)
  _repo_subarch: ct.SubArch?

  /// Custom tag pattern for changelog generation
  _tag: String?

  // Package-Local Conventions

  /// npm package scope (e.g., \"@google\")
  _npmscope: String?

  /// npm package name
  _npmname: String?

  /// npm pinned version
  _npmver: String?

  /// Local helper variable (convenience alias, e.g. _name=$pkgname)
  _name: String?

  /// Package-local convenience variable (e.g. _projectname, _sourcedirectory)
  _projectname: String?

  /// Package-local convenience variable (e.g. _sourcedirectory)
  _sourcedirectory: String?

  /// PREREVIEW marker text (injected by sync-package.py during upstream merge)
  _prereview: String?

  /// GitHub API version for changelog generation
  _github_api_version: String?

  // ── Cross-Field Constraints ──

  /// _deploy_aur and _repo_subarch are mutually exclusive (AGENTS.md §AUR Deployment Gate).
  local deploy_aur_subarch_mutex: Boolean = !(_deploy_aur && _repo_subarch != null)

  // ── Renderer Methods ──

  /// Quote a string for PKGBUILD output.
  /// Matches Py renderer's _q(): quote only if string contains space, ', or ".
  function _quoteString(s: String): String =
    if (s.isEmpty)
      "''"
    else if (!s.contains(" ") && !s.contains("'") && !s.contains("\""))
      s
    else
      "'\(s.replaceAll(Regex(#"'"#), "'\\''"))'"

  /// Render a SourceEntry for PKGBUILD source array.
  /// Matches Py renderer: always double-quoted.
  function _renderSource(e: SourceEntry): String =
    if (e.url == e.filename)
      "\"\(e.url)\""
    else
      "\"\(e.filename)::\(e.url)\""

  /// Render an OptDependsEntry for PKGBUILD optdepends array.
  /// Matches Py renderer: _q() on combined "name: desc" string.
  function _renderOptDepends(e: OptDependsEntry): String =
    if (e.desc == "")
      _quoteString(e.name)
    else
      _quoteString("\(e.name): \(e.desc)")

  /// Indent function body text by 4 spaces.
  /// Matches Py renderer: strip leading/trailing whitespace first.
  function _indentBody(body: String): String =
    body.trim().split("\n").toList().map((line) -> "    \(line)").join("\n")

  /// Render a lifecycle function block.
  function _renderFunc(name: String, body: String?): String? =
    if (body == null) null else "\n\(name)() {\n\(_indentBody(body))\n}"

  /// Render the first available checksum line only (matching Py renderer).
  function _renderChecksums(): String? =
    if (sha256sums != null && !sha256sums.isEmpty)
      "sha256sums=('\(sha256sums!!.join("' '"))')"
    else if (sha512sums != null && !sha512sums.isEmpty)
      "sha512sums=('\(sha512sums!!.join("' '"))')"
    else if (sha224sums != null && !sha224sums.isEmpty)
      "sha224sums=('\(sha224sums!!.join("' '"))')"
    else if (sha384sums != null && !sha384sums.isEmpty)
      "sha384sums=('\(sha384sums!!.join("' '"))')"
    else if (b2sums != null && !b2sums.isEmpty)
      "b2sums=('\(b2sums!!.join("' '"))')"
    else
      null

  /// Render this package as a valid PKGBUILD string.
  /// Matches Python renderer field ordering and quoting exactly.
  function renderPKGBUILD(): String =
    new Listing {
      "# Maintainer: \(maintainer)"
      when (contributor != null && !contributor.isEmpty) {
        let (cl = contributor!!)
          new Listing {
            for (c in cl) {
              "# Contributor: \(c)"
            }
          }.join("\n")
      }
      ""
      // Custom Variables — sorted alphabetically
      // Booleans: only emitted when true (matching Py renderer behavior)
      when (_auto_merge_build) { "_auto_merge_build=true" }
      when (_demote_upstream_maintainer) { "_demote_upstream_maintainer=true" }
      when (_deploy_aur) { "_deploy_aur=true" }
      when (_githubname != null && !_githubname!!.isEmpty) {
        let (v = _githubname!!) "_githubname=\"\(v)\""
      }
      when (_name != null && !_name!!.isEmpty) {
        let (v = _name!!) "_name=\"\(v)\""
      }
      when (_npmname != null && !_npmname!!.isEmpty) {
        let (v = _npmname!!) "_npmname=\"\(v)\""
      }
      when (_npmscope != null && !_npmscope!!.isEmpty) {
        let (v = _npmscope!!) "_npmscope=\"\(v)\""
      }
      when (_npmver != null && !_npmver!!.isEmpty) {
        let (v = _npmver!!) "_npmver=\"\(v)\""
      }
      when (_pkgname != null && !_pkgname!!.isEmpty) {
        let (v = _pkgname!!) "_pkgname=\"\(v)\""
      }
      when (_projectname != null && !_projectname!!.isEmpty) {
        let (v = _projectname!!) "_projectname=\"\(v)\""
      }
      when (_repo_subarch != null) {
        let (v = _repo_subarch!!) "_repo_subarch=\"\(v)\""
      }
      when (_sourcedirectory != null && !_sourcedirectory!!.isEmpty) {
        let (v = _sourcedirectory!!) "_sourcedirectory=\"\(v)\""
      }
      when (_tag != null && !_tag!!.isEmpty) {
        let (v = _tag!!) "_tag=\"\(v)\""
      }
      when (_upstream_arch_repo != null && !_upstream_arch_repo!!.isEmpty) {
        let (v = _upstream_arch_repo!!) "_upstream_arch_repo=\"\(v)\""
      }
      when (_upstream_aur_pkg != null && !_upstream_aur_pkg!!.isEmpty) {
        let (v = _upstream_aur_pkg!!) "_upstream_aur_pkg=\"\(v)\""
      }
      when (_use_common_gemini_settings) { "_use_common_gemini_settings=true" }
      // PREREVIEW marker
      when (_prereview != null && !_prereview!!.isEmpty) {
        let (p = _prereview!!)
          new Listing {
            "# PREREVIEW: \(p)"
            "# Review the diff, verify build, then remove this marker to unblock release."
          }.join("\n")
      }
      // Identity & Versioning
      "pkgname=\(pkgname)"
      when (pkgbase != null) {
        let (b = pkgbase!!) "pkgbase=\(b)"
      }
      "pkgver=\(pkgver)"
      "pkgrel=\(pkgrel)"
      when (epoch != null) {
        let (e = epoch!!) "epoch=\(e)"
      }
      "pkgdesc=\(_quoteString(pkgdesc))"
      // Architecture & Metadata
      "arch=(\(arch.toList().map((e) -> _quoteString(e)).join(" ")))"
      "url='\(url.replaceAll(Regex(#"'"#), "'\\''"))'"
      "license=(\(license.toList().map((e) -> _quoteString(e)).join(" ")))"
      when (groups != null && !groups.isEmpty) {
        let (g = groups!!) "groups=(\(g.toList().map((e) -> _quoteString(e)).join(" ")))"
      }
      // Package Relationships
      when (depends != null && !depends.isEmpty) {
        let (d = depends!!) "depends=(\(d.toList().map((e) -> _quoteString(e)).join(" ")))"
      }
      when (makedepends != null && !makedepends.isEmpty) {
        let (m = makedepends!!) "makedepends=(\(m.toList().map((e) -> _quoteString(e)).join(" ")))"
      }
      when (checkdepends != null && !checkdepends.isEmpty) {
        let (c = checkdepends!!)
          "checkdepends=(\(c.toList().map((e) -> _quoteString(e)).join(" ")))"
      }
      when (optdepends != null && !optdepends.isEmpty) {
        let (o = optdepends!!)
          "optdepends=(\(o.toList().map((e) -> _renderOptDepends(e)).join(" ")))"
      }
      when (provides != null && !provides.isEmpty) {
        let (p = provides!!) "provides=(\(p.toList().map((e) -> _quoteString(e)).join(" ")))"
      }
      when (conflicts != null && !conflicts.isEmpty) {
        let (c = conflicts!!) "conflicts=(\(c.toList().map((e) -> _quoteString(e)).join(" ")))"
      }
      when (replaces != null && !replaces.isEmpty) {
        let (r = replaces!!) "replaces=(\(r.toList().map((e) -> _quoteString(e)).join(" ")))"
      }
      // Install & Config
      when (backup != null && !backup.isEmpty) {
        let (b = backup!!) "backup=(\(b.toList().map((e) -> _quoteString(e)).join(" ")))"
      }
      when (install != null) {
        let (ins = install!!) "install=\(ins)"
      }
      when (options != null && !options.isEmpty) {
        let (o = options!!) "options=(\(o.toList().map((e) -> _quoteString(e)).join(" ")))"
      }
      when (changelog != null) {
        let (cl = changelog!!) "changelog=\(cl)"
      }
      // Source & Integrity
      when (source != null && !source.isEmpty) {
        let (s = source!!) "source=(\(s.toList().map((e) -> _renderSource(e)).join(" ")))"
      }
      when (source_x86_64 != null && !source_x86_64.isEmpty) {
        let (s = source_x86_64!!)
          "source_x86_64=(\(s.toList().map((e) -> _renderSource(e)).join(" ")))"
      }
      when (source_aarch64 != null && !source_aarch64.isEmpty) {
        let (s = source_aarch64!!)
          "source_aarch64=(\(s.toList().map((e) -> _renderSource(e)).join(" ")))"
      }
      when (_renderChecksums() != null) {
        _renderChecksums()!!
      }
      when (sha512sums_x86_64 != null && !sha512sums_x86_64.isEmpty) {
        let (s = sha512sums_x86_64!!) "sha512sums_x86_64=('\(s.join("' '"))')"
      }
      when (sha512sums_aarch64 != null && !sha512sums_aarch64.isEmpty) {
        let (s = sha512sums_aarch64!!) "sha512sums_aarch64=('\(s.join("' '"))')"
      }
      when (validpgpkeys != null && !validpgpkeys.isEmpty) {
        let (v = validpgpkeys!!)
          "validpgpkeys=(\(v.toList().map((e) -> _quoteString(e)).join(" ")))"
      }
      when (noextract != null && !noextract.isEmpty) {
        let (n = noextract!!) "noextract=(\(n.toList().map((e) -> _quoteString(e)).join(" ")))"
      }
      // Lifecycle Functions
      when (verify != null) {
        _renderFunc("verify", verify)
      }
      when (pkgverFunc != null) {
        _renderFunc("pkgver", pkgverFunc)
      }
      when (prepare != null) {
        _renderFunc("prepare", prepare)
      }
      when (build != null) {
        _renderFunc("build", build)
      }
      when (check != null) {
        _renderFunc("check", check)
      }
      when (packageFunc != null) {
        _renderFunc("package", packageFunc)
      }
    }.join("\n") + "\n"
}

// ── Default Package (for schema validation) ──

_defaultPackage: Package = new Package {
  pkgname = "testpkg"
  pkgver = "1.0"
  pkgrel = 1
  pkgdesc = "Test package for schema validation"
  arch = new Listing { "x86_64" }
  url = "https://example.com"
  license = new Listing { "MIT" }
}

// ── Module Output ──

output {
  value = _defaultPackage
}
