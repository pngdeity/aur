# Maintainer: pngdeity <pngdeity@tutanota.com>
# Contributor: alive4ever <alive4ever at live.com>
# Contributor: Earnest

pkgname=opendoas
pkgver=6.8.2
pkgrel=1
pkgdesc='Run commands as super user or another user'
url='https://github.com/Duncaen/OpenDoas'
license=('custom:ISC')
arch=(x86_64)
makedepends=(git)
depends=(pam)
provides=(doas)
conflicts=(doas)
replaces=(doas)
install=opendoas.install
source=(
    "${pkgname}::git+https://github.com/Duncaen/OpenDoas.git#tag=v${pkgver}"
    "change-path.patch"
    "rowhammer.patch"
    "retry.patch"
    "fix-gid-max.patch"
    "post-release-fixes.patch"
    "remove-argv-guard.patch"
    "doas.bash"
)
sha256sums=('43b4c2de1aaa31aac1d322b98883334b864c606783c4dfb3ddbfa0d88af9332b'
            '6adb42ac2005d0a1d3f8b24e4e319ce6aebb078861ded7904ddcd8f5e1f5592b'
            '80c9ebdb373c552730e13f6c562820a80540a96f0471f2c96170f69fba052d0a'
            'cae34e452f63dec782fe2e0a3b2ca73045a7a7f21468e7dd1ea84a11296ce8c2'
            '3e86c2601377aa0ffdf132365838caa4bdcb4c6e6b6ffddb2070e43157337b5e'
            '3b6affe9ecfa9859efc2b27fef8593ce77b75d5c434723175e49fda1d6818591'
            '7e4032bf16d0d03215941b70edc05a5d3c263cad4200664ab76b0c41b49110b5'
            '6ed5aec95cb659eda7776a04873ea12368d09ba1c93c18663e1bef00533cecdb')

prepare() {
  cd "$pkgname"
  
  # Alpine PATH patch
  patch -Np1 -i ../change-path.patch
  
  # GitHub PR #124: Rowhammer resistance
  patch -Np1 -i ../rowhammer.patch
  
  # GitHub PR #123: Retry 3 times
  patch -Np1 -i ../retry.patch
  
  # GitHub PR #130 / Issue #129: Fix GID_MAX assignment
  patch -Np1 -i ../fix-gid-max.patch

  # Post-release fixes (HEAD after 6.8.2)
  patch -Np1 -i ../post-release-fixes.patch

  # Remove redundant argv null check (project-authored, no upstream commit)
  patch -Np1 -i ../remove-argv-guard.patch
}

build() {
  cd "$pkgname"
  ./configure --prefix=/usr --with-timestamp
  make
}

package() {
  cd "$pkgname"
  make DESTDIR="$pkgdir" install
  install -Dm644 LICENSE -t "$pkgdir/usr/share/licenses/$pkgname"
  install -Dm644 "$srcdir/doas.bash" "$pkgdir/usr/share/bash-completion/completions/doas"
}
