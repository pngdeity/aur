# Maintainer: pngdeity <email@example.com>
pkgname=gemini-bash-completion
pkgver=1.0.0
pkgrel=1
pkgdesc="Bash completion for gemini-cli"
arch=('any')
url="https://github.com/scop/bash-completion"
license=('')
depends=('bash-completion')
optdepends=('gemini-cli: the tool this completion is for')
source=("gemini.bash")
sha256sums=('bd104ed519381a4bc797f32c4e0a0c9c3baea972babda8312d8900ef6399fa59')

package() {
  # Install the bash completion script system-wide
  # bash-completion >= 2.18 requires .bash file extension
  # TODO
  # Shouldn't this use the environment variable set by bash-completion?
  install -Dm644 "$srcdir/gemini.bash" \
    "$pkgdir/usr/share/bash-completion/completions/gemini.bash"
}

# ex: ts=2 sw=2 et filetype=sh
