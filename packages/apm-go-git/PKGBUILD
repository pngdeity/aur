# Maintainer: pngdeity <pngdeity@tutanota.com>
_deploy_aur=true
_pkgname=apm

pkgname=${_pkgname}-go-git
pkgver=0.14.1.r0.g0000000
pkgrel=1
pkgdesc="Agent Package Manager by Microsoft"
arch=('x86_64' 'aarch64')
url="https://github.com/githubnext/apm"
license=('MIT')
depends=('glibc' 'git')
makedepends=('go' 'git')
provides=("${_pkgname}")
conflicts=("${_pkgname}")
source=("git+${url}.git")
sha512sums=('SKIP')

pkgver() {
  cd "${_pkgname}"
  printf "0.14.1.r%s.g%s" "$(git rev-list --count HEAD)" "$(git rev-parse --short=7 HEAD)"
}

prepare() {
  cd "${_pkgname}"
  GOFLAGS="-mod=readonly" go mod vendor -v
}

build() {
  cd "${_pkgname}"
  export CGO_CPPFLAGS="${CPPFLAGS}"
  export CGO_CFLAGS="${CFLAGS}"
  export CGO_CXXFLAGS="${CXXFLAGS}"
  export CGO_LDFLAGS="${LDFLAGS}"
  export GOFLAGS="-buildmode=pie -trimpath -ldflags=-linkmode=external -mod=vendor -modcacherw"
  export GOPATH="${srcdir}"
  go build -o apm ./cmd/apm
}

package() {
  cd "${_pkgname}"
  install -Dm755 apm "${pkgdir}/usr/bin/apm"
  install -Dm644 LICENSE "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
}
