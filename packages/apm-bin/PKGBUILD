_upstream_aur_pkg="apm-bin"
_demote_upstream_maintainer=true
_githubname="microsoft/apm"
_pkgname="apm"

pkgname=apm-bin
changelog=apm-bin.changelog
pkgver=0.16.0
pkgrel=1
pkgdesc="Agent Package Manager by Microsoft"
arch=('x86_64' 'aarch64')
url="https://github.com/microsoft/apm"
license=('MIT')
depends=('git' 'glibc')
options=('!strip')
provides=("apm=$pkgver")
conflicts=('apm')
source_x86_64=("${url}/releases/download/v${pkgver}/apm-linux-x86_64.tar.gz")
source_aarch64=("${url}/releases/download/v${pkgver}/apm-linux-arm64.tar.gz")
source=("LICENSE::https://raw.githubusercontent.com/microsoft/apm/v${pkgver}/LICENSE")
sha512sums=('b5abd9f896a468d8d5459c1a475c973e4d16c7df52f11edae95ad5af0886885e87d5cc626f40fcc844f1288a47e923101e0c88f620d4215769286b367044b510')
sha512sums_x86_64=('d249268a97b057aa8f5a37d6adec156c7922f1e4615c5c724e7666ec0379dd9deb94867d9989c1bafcbff2ac700f388e7576b1733bfe22bc541ae2e6a5ee4b3e')
sha512sums_aarch64=('ebd20cb9c33062be73cd3b41b4d56417eca7e4f5667c0b806141781998ca9a6a58df8aee578979635616bbc1651e821125c99e976e61ab2e90a0c648efc79772')

package() {
    install -d "${pkgdir}/usr/lib/apm"

    if [[ "${CARCH}" == "aarch64" ]]; then
        cp -a "${srcdir}/apm-linux-arm64/"* "${pkgdir}/usr/lib/apm/"
    else
        cp -a "${srcdir}/apm-linux-x86_64/"* "${pkgdir}/usr/lib/apm/"
    fi

    install -d "${pkgdir}/usr/bin"
    ln -sf "/usr/lib/apm/apm" "${pkgdir}/usr/bin/apm"
    install -Dm644 LICENSE "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
}
