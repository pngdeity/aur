# Maintainer: pngdeity <pngdeity@tutanota.com>

pkgname=seiche
_pkgname=seiche
pkgver=1.0.1
pkgrel=1
epoch=1
pkgdesc="Application for rendering and analyzing acoustical properties of 3D spaces"
arch=(x86_64)
url="https://github.com/seicheacoustics/seiche"
_githubname="SeicheAcoustics/Seiche"
license=('MIT')
depends=(
    qt6-base
)
makedepends=(
  git
  cmake>=3.16
  ninja
  gcc
  jq
)
optdepends=(
  'qt6-svg: for SVG icon support'
)
checkdepends=(
    # No standard test runner identified; normally would be gtest or similar
)
provides=("$_pkgname")
conflicts=("$_pkgname")
source=("$_pkgname-src::git+$url.git#tag=v${pkgver}")
sha256sums=('SKIP')
backup=(
    # config file paths
)

prepare() {
  cd "$_pkgname-src"
  
  # Fetch release notes for the changelog.
  # Using the GitHub API as a seasoned DevOps engineer to automate changelogs.
  echo "Fetching release notes for v$pkgver..."
  curl -sH "X-GitHub-Api-Version: 2026-03-10" \
    "https://api.github.com/repos/$_githubname/releases/tags/v$pkgver" | \
    jq -r '.body // "No release notes available for this version."' | \
    sed -E -e 's|@([a-zA-Z0-9-]+)|[@\1](https://github.com/\1)|g' \
           -e 's|https://github.com/[^/ ]+/[^/ ]+/pull/([0-9]+)|[#\1](&)|g' \
    > "../$pkgname.changelog"
}

build() {
  # Standard Arch Linux CMake build pattern
  cmake -B build -S "$_pkgname-src" \
    -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -G Ninja
  cmake --build build --config Release
}

check() {
  # Optional: cmake --build build --target test
  :
}

package() {
  # Prefer cmake --install if supported by upstream
  DESTDIR="$pkgdir" cmake --install build

  # If materials were not installed by cmake, handle manually
  if [[ ! -d "$pkgdir/usr/share/seiche/materials" ]]; then
    install -d "$pkgdir/usr/share/seiche"
    cp -a "$_pkgname-src/materials" "$pkgdir/usr/share/seiche/"
  fi

  # Install docs and licenses
  install -vDm644 "$srcdir/$pkgname.changelog" "$pkgdir/usr/share/doc/$pkgname/$pkgname.changelog"
  install -vDm644 -t "$pkgdir/usr/share/doc/$pkgname" "$_pkgname-src/README.md"
  install -vDm644 -t "$pkgdir/usr/share/licenses/$pkgname" "$_pkgname-src/LICENSE"
}
