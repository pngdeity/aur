# Maintainer: pngdeity <pngdeity@tutanota.com>

_npmscope=@google
_npmname=jules
pkgname=jules-tools
pkgver=0.1.42
pkgrel=1
pkgdesc="Jules, the asynchronous coding agent from Google, in the terminal."
arch=(any)
url="https://jules.google"
license=('custom:Proprietary')
depends=('nodejs' 'npm')
makedepends=('npm')
optdepends=()
source=(
  "https://registry.npmjs.org/${_npmscope}/${_npmname}/-/${_npmname}-${pkgver}.tgz"
)
noextract=("${_npmname}-${pkgver}.tgz")
sha256sums=('84d85b13777236e4815b787910f4b74d1959cad3b3bf722f2b6306f3786a0f75')

package() {
  cd "$srcdir"
  npm install -g --prefix "$pkgdir/usr" "${_npmname}-${pkgver}.tgz"

  # Fix permissions and remove build artifacts if any
  find "$pkgdir/usr" -type d -exec chmod 755 {} +
  
  # Remove references to pkgdir in the installed files
  find "$pkgdir" -type f -name "package.json" -exec sed -i "s|$pkgdir||g" {} +
}

