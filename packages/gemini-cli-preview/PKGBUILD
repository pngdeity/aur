# Maintainer: pngdeity <pngdeity@tutanota.com>

# Use shared asset automation (see scripts/sync-package.sh)
_use_common_gemini_settings=true

pkgname=gemini-cli-preview
changelog=gemini-cli-preview.changelog
_upstream_arch_repo="archlinux/packaging/packages/gemini-cli"
_pkgname=gemini-cli
pkgver=0.38.0
pkgrel=2
epoch=1
pkgdesc="Open-source AI agent that brings the power of Gemini directly into your terminal (preview version)"
arch=('x86_64')
url="https://github.com/google-gemini/gemini-cli"
license=('Apache-2.0')
depends=(
  'glib2'
  'glibc'
  'libgcc'
  'libsecret'
  'libstdc++'
  'nodejs'
)
makedepends=(
  'git'
  'jq'
  'node-gyp'
  'npm'
  'python'
)
optdepends=(
  'ripgrep: file content search'
  'wl-clipboard: clipboard image pasting on Wayland'
  'xclip: clipboard image pasting on X11'
  'xdg-utils: opening URLs in default browser'
)
checkdepends=(
  'vim'
)
provides=("$_pkgname")
conflicts=("$_pkgname")
_githubname="google-gemini/gemini-cli"
_tag="v$pkgver-preview.0"
backup=('etc/gemini-cli/settings.json')
source=("$_pkgname-src::git+$url.git#tag=$_tag"
        'settings.json')
sha256sums=('fa8cfc74a5af04fce0d0d150e1015ade98abf908b73be6379c0b0a0cbfbedbc0'
            '6a813a4a219dc135b96f50290e3b4e785577f9d9cd6174039eeb3d4618cfd180')

prepare() {
  cd "$_pkgname-src"
  npm clean-install --ignore-scripts
}

build() {
  cd "$_pkgname-src"
  npm run bundle
  # Build keytar native addon to enable OS keychain integration via libsecret
  (
    cd node_modules/keytar
    node-gyp rebuild
  )
  local bundled=$(jq '.dependencies + .optionalDependencies | keys' package.json)
  npm pkg set --json bundledDependencies="$bundled"
  npm pack
}

check() {
  cd "$_pkgname-src"
  npm run build
  # Deselect failing tests
  npm test -- \
    --exclude='**/BuiltinCommandLoader.test.ts' \
    --exclude='**/config.integration.test.ts' \
    --exclude='**/mcp-client.test.ts'
}

package() {
  cd "$_pkgname-src"
  local _pkgver=$(jq -r .version package.json)
  npm install --global --offline --prefix "$pkgdir/usr" \
    google-$_pkgname-$_pkgver.tgz

  # Remove node-gyp build artifacts
  rm -vr "$pkgdir/usr/lib/node_modules/@google/gemini-cli/node_modules/keytar/build/Release/obj.target"

  find "$pkgdir" -type f -name "package.json" -exec sed -i \
    -e "s|$pkgdir||g" \
    -e '/"_[a-z0-9]*":/d' \
    {} +

  install -vDm644 -t "$pkgdir/usr/share/doc/$pkgname" README.md
  install -vDm644 -t "$pkgdir/usr/share/licenses/$pkgname" LICENSE

  # Disable auto-update: gemini-cli is managed by pacman, not npm
  install -vDm644 "$srcdir/settings.json" "$pkgdir/etc/gemini-cli/settings.json"
}
