_pkgname=doas-bash-completion
_githubname="aarchetype/bash-completion"
pkgname=$_pkgname
pkgver=1.0.0
pkgrel=1
pkgdesc="Bash completion for opendoas"
arch=('any')
url="https://github.com/aarchetype/bash-completion"
license=('GPL-2.0-only')
depends=('bash-completion')
source=("doas.bash")
sha256sums=('1eab87bdb9d1671b9be72528ade4e05a69a1f748eac353731ab95f1b096c6d1e')

package() {
  install -Dm644 "doas.bash" \
    "$pkgdir/usr/share/bash-completion/completions/doas"
}
