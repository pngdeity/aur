pkgname=doas-bash-completion
pkgver=1.0.0
pkgrel=1
pkgdesc="Bash completion for opendoas"
arch=('any')
url="https://github.com/aarchetype/bash-completion"
license=('GPL-2.0-only')
depends=('bash-completion')
source=("doas.bash")
sha256sums=('SKIP')

package() {
  install -Dm644 "doas.bash" \
    "$pkgdir/usr/share/bash-completion/completions/doas"
}
