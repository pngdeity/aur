# Maintainer: pngdeity <pngdeity@tutanota.com>
_deploy_aur=true

_pkgname=pkl-lsp
pkgname=${_pkgname}-bin
_githubname="apple/pkl-lsp"
pkgver=0.7.1
pkgrel=1
pkgdesc="Language Server Protocol implementation for Pkl"
arch=('any')
url="https://github.com/apple/pkl-lsp"
license=('Apache-2.0')
depends=('java-runtime')
provides=("$_pkgname")
conflicts=("$_pkgname")
source=("${_pkgname}-${pkgver}.jar::${url}/releases/download/${pkgver}/${_pkgname}-${pkgver}.jar")
sha256sums=('4e84450537c1b5e0eddf6f64fc93ae6f884ff45ee3ed4296b5c061e7a7c7f34e')

package() {
	install -Dm644 "${_pkgname}-${pkgver}.jar" \
		"${pkgdir}/usr/share/java/${_pkgname}/${_pkgname}.jar"
	install -Dm755 /dev/stdin "${pkgdir}/usr/bin/${_pkgname}" <<'EOF'
#!/bin/sh
exec /usr/bin/java -jar '/usr/share/java/pkl-lsp/pkl-lsp.jar' "$@"
EOF
}
