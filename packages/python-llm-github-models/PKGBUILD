# Maintainer: pngdeity <pngdeity@tutanota.com>
_deploy_aur=true

pkgname=python-llm-github-models
_name=${pkgname#python-}
changelog=python-llm-github-models.changelog
pkgver=0.18.0
pkgrel=1
pkgdesc="LLM plugin to access GitHub Models API"
arch=('any')
url="https://github.com/tonybaloney/llm-github-models"
license=('Apache-2.0')

# AUTOMATED METADATA
_githubname="tonybaloney/llm-github-models"

depends=(
  'python'
  'python-aiohttp'
  'python-llm'
  'python-azure-ai-inference'
)
makedepends=(
  'python-build'
  'python-installer'
  'python-setuptools'
  'python-wheel'
)
checkdepends=(
  'python-pytest'
  'python-pytest-recording'
  'python-pytest-asyncio'
)

source=("${pkgname}-${pkgver}.tar.gz::https://files.pythonhosted.org/packages/source/l/$_name/${_name//-/_}-$pkgver.tar.gz")
sha256sums=('b778aa6fa43e53ecb3b868fcf9875bc0e760a774a1fad76ea907a269582a2043')

build() {
  cd "${_name//-/_}-${pkgver}"
  python -m build --wheel --no-isolation
}

check() {
  cd "${_name//-/_}-${pkgver}"
  PYTHONPATH="$PWD/src" pytest
}

package() {
  cd "${_name//-/_}-${pkgver}"
  python -m installer --destdir="$pkgdir" dist/*.whl
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
