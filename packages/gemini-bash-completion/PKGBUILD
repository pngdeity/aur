_pkgname=gemini-bash-completion
_githubname="google-gemini/gemini-cli"
pkgname=$_pkgname
pkgver=1.0.0
pkgrel=1
pkgdesc="Bash completion for gemini-cli"
arch=('any')
url="https://github.com/google-gemini/gemini-cli"
license=('Apache-2.0')
depends=('bash-completion')
source=("gemini.bash")
sha256sums=('e7990fafa0f4dbff1971d6d68a0b07b051d16846351b114fa05077e9a78d2fb5')

package() {
  install -Dm644 "gemini.bash" \
    "$pkgdir/usr/share/bash-completion/completions/gemini"
}

