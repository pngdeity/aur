# Arch Linux build artifacts
*.pkg.tar.*
*.src.tar.*

# Extracted sources and build directories
src/
pkg/

# Downloaded source archives
*.tar.gz
*.tar.xz
*.tar.bz2
*.zip
*.tar.zst

# Logs
*.log

# Other artifacts
logpipe.*

# Handoff directory
handoffs/

# nvchecker local state
keyfile.toml

# Python bytecode cache
__pycache__/
*.pyc
*.pyo

# Background process output
nohup.out

# Tool config
.opencode/

# Generated wrapper artifacts
packages/*/package.pkl
packages/*/package.json
manifest.json

# SRCINFO as build artifact (per SRCINFO-VERSION-CONTROL-POLICY.md)
packages/*/.SRCINFO

# Ignore AUR .git metadata 
packages/*/.git

# makepkg bare clones for git+ sources. makepkg checks out <name>/ in the
# PKGBUILD's directory (and src/<name>/ for the worktree), where <name> is the
# upstream repo name, not the package name. amass-git gets packages/amass-git/
# amass/ and opendoas gets packages/opendoas/opendoas/. Without this, a
# discovery run stages a multi-hundred-MB clone and the push is rejected.
packages/*/*/.git/
packages/amass-git/amass/
packages/opendoas/opendoas/

# sync-package.sh's merge baseline. It downloads the upstream PKGBUILD to
# PKGBUILD.new and keeps a copy as .PKGBUILD.upstream to detect drift on the
# next run; it is fetched afresh each time, never needed from history, and no
# commit in this repository has ever tracked one.
packages/*/.PKGBUILD.upstream

# Downloaded source= payloads. sync-package.sh's fetch_upstream_assets()
# pulls any source entry named with the local-name form (foo::https://...) into
# the package directory. These are build inputs, reproducible from the URL in
# source=, so they do not belong in history.
#
# regal declares the same local name for both architectures (regal_Linux), so
# the entries are fetched under their URL basenames instead -- regal_Linux_*
# covers those as well as the bare name. Enumerating exact names here missed
# the per-arch files and a discovery run committed them.
*.tgz
packages/*/regal_Linux*

# Downloaded license files (source=("LICENSE.txt::..."))
packages/*/LICENSE*

# Upstream helper files copied into the source tree by build()
packages/*/requirements.txt

# Downloaded data artifacts (e.g. GeoIP databases)
*.mmdb
